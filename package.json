{
  "name": "sgd-legal-unicordoba-prototipo",
  "version": "2.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/innelsonn/sgd-legal-unicordoba.git"
  },
  "description": "Prototipo navegable de SGD-LEGAL Unicórdoba: Sistema de Gestión Documental Legal y Consolidación Normativa de la Universidad de Córdoba.",
  "scripts": {
    "start": "npx --yes http-server@14.1.1 . -p 8080 -c-1 -o",
    "test": "node --test --test-concurrency=1 tests/e2e.test.js",
    "lint": "eslint js tests",
    "format": "prettier --write \"js/**/*.js\" \"tests/**/*.js\" index.html",
    "check": "npm run lint && prettier --check \"js/**/*.js\" \"tests/**/*.js\" && npm test"
  },
  "devDependencies": {
    "axe-core": "4.10.2",
    "eslint": "9.14.0",
    "globals": "15.12.0",
    "playwright": "1.63.0",
    "prettier": "3.3.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0"
}
